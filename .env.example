# Hommy Cottage - Environment Variables Template
# Copy this file to .env and update with your local MySQL credentials

FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=hommy-cottage-super-secret-key-2026-dbms-project

# MySQL / TiDB Database Configuration
# Local MySQL default:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hommy_cottage

# For TiDB Cloud (Serverless/Dedicated):
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=your_tidb_user.root
# DB_PASSWORD=your_tidb_password
# DB_NAME=test
# DB_SSL=true

# Upload configurations
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=static/uploads
