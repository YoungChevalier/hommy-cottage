# Normalize line endings: LF in the repo, native on checkout
* text=auto eol=lf

# Force LF for Python and config files
*.py   text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.toml text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.env* text eol=lf

# Binary files — do not mess with line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.whl  binary
*.pyc  binary
